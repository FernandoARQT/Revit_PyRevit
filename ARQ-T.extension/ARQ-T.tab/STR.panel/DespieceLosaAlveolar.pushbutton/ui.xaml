<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ARQ-T | Despiece losa alveolar" Width="1120" Height="900" MinWidth="950" MinHeight="700" Background="#F5F6F8" WindowStartupLocation="CenterScreen" FontFamily="Century Gothic" FontSize="12" Foreground="#25272B">
<Window.Resources>
 <Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#25272B"/><Setter Property="BorderBrush" Value="#E2E4E8"/><Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#25272B"/><Setter Property="BorderBrush" Value="#E2E4E8"/><Setter Property="Padding" Value="5,3"/></Style>
 <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F5F6F8"/><Setter Property="BorderBrush" Value="#E2E4E8"/><Setter Property="HorizontalGridLinesBrush" Value="#E2E4E8"/></Style>
 <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#25272B"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="8,6"/></Style>
 <Style TargetType="DataGridRow"><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FFE5CF"/><Setter Property="Foreground" Value="#25272B"/></Trigger></Style.Triggers></Style>
 <Style TargetType="ListBoxItem"><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FFE5CF"/><Setter Property="Foreground" Value="#25272B"/></Trigger></Style.Triggers></Style>
</Window.Resources>

 <DockPanel Margin="18" Background="#F5F6F8">
  <StackPanel DockPanel.Dock="Bottom">
   <TextBlock Name="Status" TextWrapping="Wrap" Foreground="#9B382A" Margin="0,6"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Name="Calculate" Background="#F47721" FontWeight="Bold" Content="Calcular despiece" Padding="15,8" Margin="5"/>
    <Button Name="Reverse" Content="Invertir disposición" Padding="15,8" Margin="5"/>
    <Button Name="Generate" Background="#F47721" FontWeight="Bold" Content="Generar placas" IsEnabled="False" Padding="15,8" Margin="5"/>
    <Button Name="Cancel" Content="Cancelar" Padding="15,8" Margin="5"/>
   </StackPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TextBlock Text="Despiece losa alveolar" FontSize="25" FontWeight="Bold" Foreground="#25272B"/>
    <TextBlock Name="FloorLabel" Text="Seleccione un forjado rectangular." TextWrapping="Wrap" Margin="0,10"/>
    <StackPanel Orientation="Horizontal">
     <Button Name="Select" Content="Seleccionar forjado" Padding="10,5"/>
     <TextBlock Text="Dirección longitudinal: " Margin="18,5,5,0"/>
     <ComboBox Name="Direction" Width="100"><ComboBoxItem Content="N-S"/><ComboBoxItem Content="E-O"/></ComboBox>
    </StackPanel>
    <TextBlock Text="Catálogo editable · anchuras enteras en mm · categoría 1/2/3 · penalización" Margin="0,15,0,5" FontWeight="Bold"/>
    <TabControl Name="Catalog" Height="205">
     <TabItem Header="1 · Comunes"><DataGrid Name="Group1" AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"/></TabItem>
     <TabItem Header="2 · Especiales habituales"><DataGrid Name="Group2" AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"/></TabItem>
     <TabItem Header="3 · Muy especiales"><DataGrid Name="Group3" AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"/></TabItem>
    </TabControl>
    <StackPanel Orientation="Horizontal" Margin="0,5">
     <Button Name="Add" Content="Añadir anchura" Padding="10,4" Margin="0,0,8,0"/>
     <Button Name="Delete" Content="Eliminar seleccionada" Padding="10,4" Margin="0,0,8,0"/>
     <Button Name="Save" Content="Confirmar edición / Guardar" Padding="10,4" Margin="0,0,8,0"/>
     <Button Name="Reset" Content="Restaurar valores predeterminados" Padding="10,4"/>
    </StackPanel>
    <TextBlock Text="Holguras y preferencias · mm · sin juntas adicionales entre placas" FontWeight="Bold" Margin="0,10,0,5"/>
    <WrapPanel Name="Fields"/>
    <StackPanel Orientation="Horizontal" Margin="0,5">
     <TextBlock Text="Borde izquierdo (nota): "/><TextBox Name="LeftEdge" Width="200"/>
     <TextBlock Text="Borde derecho (nota): " Margin="15,0,0,0"/><TextBox Name="RightEdge" Width="200"/>
    </StackPanel>
    <ListBox Name="Solutions" Height="160" Margin="0,12,0,5" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    <Border BorderBrush="#AAAAAA" BorderThickness="1"><Canvas Name="Preview" Height="160" Width="960" Background="#FAFAFA"/></Border>
    <TextBlock Text="Generar placas sustituye el suelo original. Solo conserva tipo, nivel y desfase. Las tolerancias son informativas; el montaje requiere validar también las dimensiones del hueco y los datos del fabricante." TextWrapping="Wrap" Margin="0,8" Foreground="#666666"/>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
