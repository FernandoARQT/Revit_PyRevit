<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ARQ-T | Trazado automático MEP" Width="1320" Height="900" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F5F6F8" Foreground="#25272B" FontFamily="Century Gothic" FontSize="12">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E4E8"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,0,7,7"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E4E8"/><Setter Property="Padding" Value="5,4"/><Setter Property="Margin" Value="0,2,10,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="28"/><Setter Property="Margin" Value="0,2,10,8"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F5F6F8"/><Setter Property="BorderBrush" Value="#E2E4E8"/><Setter Property="HorizontalGridLinesBrush" Value="#E2E4E8"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="MinColumnWidth" Value="85"/><Setter Property="ColumnWidth" Value="120"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#25272B"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="8,6"/></Style>
 </Window.Resources>
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="95"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Trazado automático MEP" FontSize="26" FontWeight="Bold"/><TextBlock Name="DocumentLabel" Foreground="#666666" Margin="0,4,0,12"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Sistema disponible"/><ComboBox SelectedIndex="0"><ComboBoxItem Content="Ventilación radial · recuperador de calor"/></ComboBox></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="Recuperador de referencia · selección explícita"/><ComboBox Name="HRV"/></StackPanel>
  </Grid>
  <TabControl Name="Tabs" Grid.Row="2">
   <TabItem Header="1 · Distribuidores"><DockPanel Margin="10">
    <WrapPanel DockPanel.Dock="Top"><Button Name="Refresh" Content="Actualizar equipos"/><Button Name="OriginsNone" Content="Excluir todos"/><Button Name="PreviousConnections" Content="Conexiones previas…"/></WrapPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="Seleccione distribuidores completos y asigne SUPPLY (impulsión) o EXTRACT (extracción). El recuperador alimenta sus entradas principales; las derivaciones se asignan automáticamente a los terminales de cada red. Las conexiones existentes se conservan hasta que elija eliminarlas en Conexiones previas." TextWrapping="Wrap" Margin="0,10,0,0"/>
    <DataGrid Name="Origins"><DataGrid.Columns>
     <DataGridCheckBoxColumn Header="Usar" Binding="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
     <DataGridTextColumn Header="Distribuidor / ID" Binding="{Binding Device}" IsReadOnly="True" Width="*"/>
     <DataGridComboBoxColumn x:Name="OriginRole" Header="Impulsión / extracción" SelectedItemBinding="{Binding Network}" Width="155"/>
     <DataGridTextColumn Header="Derivaciones" Binding="{Binding Capacity}" IsReadOnly="True" Width="100"/>
     <DataGridTextColumn Header="Libres" Binding="{Binding Available}" IsReadOnly="True" Width="85"/>
     <DataGridTextColumn Header="Tomas identificadas" Binding="{Binding Details}" IsReadOnly="True" Width="300"/>
    </DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
   <TabItem Header="2 · Destinos"><DockPanel Margin="10">
    <WrapPanel DockPanel.Dock="Top"><Button Name="DestAll" Content="Seleccionar todos los disponibles"/><Button Name="DestNone" Content="Excluir todos"/></WrapPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="Flow se lee de la instancia y no se modifica. Si un terminal tiene varios conectores, seleccione solo uno. SUPPLY = impulsión; EXTRACT = extracción. Sin conector o Flow verificable, la fila no se acepta para cálculo." TextWrapping="Wrap" Margin="0,10,0,0"/>
    <DataGrid Name="Destinations"><DataGrid.Columns>
     <DataGridCheckBoxColumn Header="Incluir" Binding="{Binding Include}"/>
     <DataGridTextColumn Header="Terminal / ID" Binding="{Binding Device}" IsReadOnly="True" Width="*"/>
     <DataGridTextColumn Header="Habitación" Binding="{Binding Room}" IsReadOnly="True" Width="130"/>
     <DataGridComboBoxColumn x:Name="DestRole" Header="Red interior" SelectedItemBinding="{Binding Network}" Width="115"/>
     <DataGridTextColumn Header="Flow L/s" Binding="{Binding Flow}" IsReadOnly="True"/>
     <DataGridTextColumn Header="Puerto" Binding="{Binding Port}" IsReadOnly="True"/>
     <DataGridTextColumn Header="XYZ internas mm" Binding="{Binding XYZ}" IsReadOnly="True" Width="235"/>
    </DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
   <TabItem Header="3 · Configuración"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
    <TextBlock Text="Profundidad de cálculo · tiempo máximo"/><ComboBox Name="RoutingMode" Width="240" HorizontalAlignment="Left"/>
    <WrapPanel>
     <StackPanel Width="150"><TextBlock Text="Ø nominal / exterior mm"/><TextBox Name="Diameter"/></StackPanel>
     <StackPanel Width="120"><TextBlock Text="Aislamiento mm"/><TextBox Name="Insulation"/></StackPanel>
     <StackPanel Width="120"><TextBlock Text="Holgura mm"/><TextBox Name="Clearance"/></StackPanel>
     <StackPanel Width="140"><TextBlock Text="Radio de giro mm"/><TextBox Name="BendRadius"/></StackPanel>
     <StackPanel Width="140"><TextBlock Text="Resolución fina mm"/><TextBox Name="Resolution"/></StackPanel>
    </WrapPanel>
    <CheckBox Name="UseDistributors" Content="Exigir distribuidores separados de impulsión y extracción" Margin="0,0,0,8"/>
    <CheckBox Name="IncludeLinks" Content="Incluir sólidos de modelos vinculados y sus transformaciones" Margin="0,0,0,8"/>
    <TextBlock Text="Configuración avanzada JSON · pesos, límites, fase, reglas de elementos, regiones permitidas/prohibidas/preferentes y pasos. Las dimensiones superiores prevalecen. Los pasos estructurales siguen condicionados hasta validación técnica." TextWrapping="Wrap"/>
    <TextBox Name="Configuration" AcceptsReturn="True" Height="330" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    <Button Name="SaveSettings" Content="Guardar preferencias de usuario" HorizontalAlignment="Left"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="4 · Referencias manuales"><Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Text="Referencias explícitas de diseño, en coordenadas internas de Revit convertidas a mm. No sustituyen conectores verificados. Una salida por ramal. Use puntos medidos del proyecto; no se generan coordenadas automáticamente." TextWrapping="Wrap" Margin="0,0,0,10"/>
    <TextBlock Grid.Row="1" Text="Orígenes: [{&quot;id&quot;:&quot;distribuidor-S-1&quot;, &quot;xyz_mm&quot;:[x,y,z], &quot;network_type&quot;:&quot;SUPPLY&quot;, &quot;kind&quot;:&quot;DISTRIBUTOR&quot;}]" TextWrapping="Wrap"/>
    <TextBox Grid.Row="2" Name="ManualOrigins" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
    <TextBlock Grid.Row="3" Text="Destinos: [{&quot;id&quot;:&quot;destino-1&quot;, &quot;xyz_mm&quot;:[x,y,z], &quot;network_type&quot;:&quot;SUPPLY&quot;, &quot;airflow_lps&quot;:8}]" TextWrapping="Wrap"/>
    <TextBox Grid.Row="4" Name="ManualDestinations" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
   </Grid></TabItem>
   <TabItem Header="5 · Rutas y alternativas"><Grid Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="130"/></Grid.RowDefinitions>
    <WrapPanel><Button Name="Alternatives" Content="Comparar alternativas"/><ComboBox Name="Alternative" Width="230"/><Button Name="SelectAlternative" Content="Usar alternativa"/><Button Name="Recalculate" Content="Recalcular selección"/></WrapPanel>
    <DataGrid Grid.Row="1" Name="Routes"><DataGrid.Columns>
     <DataGridCheckBoxColumn Header="Bloquear" Binding="{Binding Locked}"/>
     <DataGridTextColumn Header="Ruta" Binding="{Binding Id}" IsReadOnly="True" Width="*"/>
     <DataGridTextColumn Header="Red" Binding="{Binding Network}" IsReadOnly="True"/>
     <DataGridTextColumn Header="L/s" Binding="{Binding Flow}" IsReadOnly="True"/>
     <DataGridTextColumn Header="Ø mm" Binding="{Binding Diameter}" IsReadOnly="True"/>
     <DataGridTextColumn Header="m" Binding="{Binding Length}" IsReadOnly="True"/>
     <DataGridTextColumn Header="Codos" Binding="{Binding Bends}" IsReadOnly="True"/>
     <DataGridTextColumn Header="Validación" Binding="{Binding Status}" IsReadOnly="True" Width="190"/>
     <DataGridTextColumn Header="Aprobación" Binding="{Binding Approval}" IsReadOnly="True" Width="120"/>
    </DataGrid.Columns></DataGrid>
    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
     <StackPanel Width="110"><TextBlock Text="Ø selección mm"/><TextBox Name="RouteDiameter"/></StackPanel>
     <StackPanel Width="110"><TextBlock Text="Holgura mm"/><TextBox Name="RouteClearance"/></StackPanel>
     <StackPanel Width="300"><TextBlock Text="Waypoints XYZ mm · lista JSON"/><TextBox Name="Waypoints"/></StackPanel>
     <StackPanel Width="210"><TextBlock Text="Responsable técnico"/><TextBox Name="Responsible"/></StackPanel>
     <StackPanel Width="210"><TextBlock Text="Referencia de validación de pasos"/><TextBox Name="TechnicalReference"/></StackPanel>
     <Button Name="Approve" Content="Aprobar ruta" VerticalAlignment="Bottom"/>
    </WrapPanel>
    <TextBlock Grid.Row="3" Text="Propiedades y diagnósticos de la ruta seleccionada"/>
    <TextBox Grid.Row="4" Name="Properties" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"/>
   </Grid></TabItem>
   <TabItem Header="6 · Propuestas guardadas"><DockPanel Margin="12">
    <WrapPanel DockPanel.Dock="Top"><Button Name="ListSaved" Content="Consultar propuestas del proyecto"/><Button Name="LoadSaved" Content="Recuperar seleccionada"/></WrapPanel>
    <ListBox Name="Saved"/>
   </DockPanel></TabItem>
   <TabItem Header="Conductos · V3" Name="DesignTab"><Grid Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,8"><Button Name="DesignCreate" Content="Crear esquema"/><ComboBox Name="DesignProposals" Width="260" Margin="0,0,8,0"/><Button Name="DesignLoad" Content="Recuperar"/><Button Name="DesignDuplicate" Content="Duplicar"/><Button Name="DesignExport" Content="Guardar imagen"/></WrapPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,8"><TextBlock Text="Planta" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox Name="DesignLevel" Width="160" Margin="0,0,8,0"/><ComboBox Name="DesignNetwork" Width="140" Margin="0,0,8,0" SelectedIndex="0"><ComboBoxItem Content="Impulsión"/><ComboBoxItem Content="Extracción"/><ComboBoxItem Content="Compartido"/></ComboBox><Button Name="DesignDraw" Content="Dibujar corredor"/><Button Name="DesignFinish" Content="Terminar"/><Button Name="DesignInsert" Content="Añadir punto"/><Button Name="DesignDelete" Content="Eliminar"/><Button Name="DesignUndo" Content="Deshacer"/><Button Name="DesignRedo" Content="Rehacer"/><Button Name="DesignFit" Content="Ajustar plano"/></WrapPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="Corredores" FontWeight="Bold" Margin="0,0,0,5"/><ListBox Name="DesignCorridors" Height="180"/>
      <Expander Header="Perfil y análisis del edificio" Margin="0,10,0,5"><StackPanel>
       <TextBlock Text="Referencia del producto"/><TextBox Name="DesignProfileReference"/>
       <TextBlock Text="Diámetro nominal · mm"/><TextBox Name="DesignNominal"/>
       <TextBlock Text="Diámetro interior · mm"/><TextBox Name="DesignInternal"/>
       <TextBlock Text="Diámetro exterior · mm"/><TextBox Name="DesignExternal"/>
       <TextBlock Text="Aislamiento · mm"/><TextBox Name="DesignInsulation" Text="0"/>
       <TextBlock Text="Radio mínimo del producto · mm"/><TextBox Name="DesignBendRadius"/>
       <TextBlock Text="Holgura de análisis · mm"/><TextBox Name="DesignClearance" Text="10"/>
       <Button Name="DesignAnalyze" Content="Analizar edificio" Margin="0,8,0,5"/>
       <Button Name="DesignGenerate" Content="Generar corredores" Margin="0,0,0,5"/>
       <Button Name="DesignCancelSearch" Content="Cancelar cálculo"/>
      </StackPanel></Expander>
      <TextBlock Text="Restricción del corredor" Margin="0,10,0,3"/><ComboBox Name="DesignConstraint" SelectedIndex="0"><ComboBoxItem Content="Preferente"/><ComboBoxItem Content="Obligatorio"/><ComboBoxItem Content="Bloqueado"/></ComboBox><Button Name="DesignSetConstraint" Content="Aplicar restricción" Margin="0,5,0,5"/>
      <Button Name="DesignSetNetwork" Content="Asignar red seleccionada"/>
      <TextBlock Text="Vértice (desde 1)" Margin="0,10,0,3"/><TextBox Name="DesignVertex" Text="1"/>
      <TextBlock Text="X · mm" Margin="0,5,0,3"/><TextBox Name="DesignX"/><TextBlock Text="Y · mm" Margin="0,5,0,3"/><TextBox Name="DesignY"/>
      <Button Name="DesignMoveVertex" Content="Mover punto" Margin="0,5,0,5"/><Button Name="DesignDeleteVertex" Content="Eliminar punto"/>
      <TextBlock Text="Esquema virtual pendiente de comprobar en 3D. Los corredores dibujados no acreditan pasos ni capacidad." Foreground="#707782" TextWrapping="Wrap" Margin="0,12,0,0"/>
     </StackPanel></ScrollViewer>
     <Border Grid.Column="2" Background="White" BorderBrush="#E2E4E8" BorderThickness="1"><Canvas Name="DesignPreview" Focusable="True" ClipToBounds="True"/></Border>
    </Grid>
    <TextBlock Grid.Row="3" Name="DesignInfo" Foreground="#707782" TextWrapping="Wrap" Margin="0,8,0,0" Text="Cree un esquema desde la distribución actual o recupere uno guardado. Rueda: zoom · botón derecho/central: desplazar."/>
   </Grid></TabItem>
  </TabControl>
  <TextBlock Grid.Row="3" Name="Summary" Text="Sin análisis. Abrir esta ventana no modifica elementos." FontWeight="Bold" TextWrapping="Wrap" Margin="0,12,0,8"/>
  <TextBox Grid.Row="4" Name="Issues" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="White"/>
  <WrapPanel Grid.Row="5" Margin="0,8,0,0">
   <Button Name="Analyze" Content="Analizar geometría"/><Button Name="Calculate" Content="Calcular recorridos" Background="#F47721" ToolTip="Coloca o reutiliza los codos de las rejillas y calcula recorridos hasta sus salidas. Prueba giros de 0°, ±15°, ±30° y ±45° hacia el distribuidor."/>
   <Button Name="Preview" Content="Mostrar en Revit / localizar 3D"/><Button Name="Hide" Content="Ocultar ejes"/>
   <Button Name="ModelNetwork" Content="Modelar y conectar" Background="#F47721" ToolTip="Crea conductos reales de rutas aprobadas y comprueba cada extremo. Solo recuperación de calor."/>
   <Button Name="AuditNetwork" Content="Comprobar conexiones"/>
   <Button Name="SaveProposal" Content="Guardar propuesta"/><Button Name="CancelSearch" Content="Cancelar cálculo"/><Button Name="Close" Content="Cerrar"/>
  </WrapPanel>
 </Grid>
</Window>
